{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "findings", "verification"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["pass", "changes_needed", "verification_blocked"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "blocking", "issue", "evidence"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "checked", "missing"],
      "properties": {
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
