{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode (Bun-specific)
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,

    // Workspace module resolution
    "baseUrl": ".",
    "paths": {
      "@lobu/core": ["packages/core/src/index.ts"],
      "@lobu/core/*": ["packages/core/src/*"],
      "@lobu/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@lobu/plugin-api/*": ["packages/plugin-api/src/*"],
      "@lobu/plugin-host": ["packages/plugin-host/src/index.ts"],
      "@lobu/plugin-host/*": ["packages/plugin-host/src/*"],
      "@lobu/plugin-toolkit": ["packages/plugin-toolkit/src/index.ts"],
      "@lobu/plugin-memory": ["packages/plugin-memory/src/index.ts"],
      "@lobu/plugin-conversations": [
        "packages/plugin-conversations/src/index.ts"
      ],
      "@lobu/plugin-media": ["packages/plugin-media/src/index.ts"],
      "@lobu/plugin-mcp": ["packages/plugin-mcp/src/index.ts"],
      "@lobu/connector-sdk": ["packages/connector-sdk/src/index.ts"],
      "@lobu/connector-sdk/*": ["packages/connector-sdk/src/*"],
      "@lobu/device-connectors": ["packages/device-connectors/src/index.ts"],
      "@lobu/device-connectors/*": ["packages/device-connectors/src/*"],
      "@lobu/client": ["packages/client/src/index.ts"],
      "@lobu/client/*": ["packages/client/src/*"],
      "@lobu/connector-worker/*": ["packages/connector-worker/src/*"],
      "@lobu/connectors/*": ["packages/connectors/src/*"]
    }
  },
  "include": ["packages/*/src/**/*", "src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "packages/*/src/__tests__/**/*",
    "packages/cli/**/*",
    "packages/client/**/*",
    "packages/server/**/*",
    "packages/connector-sdk/**/*",
    "packages/device-connectors/**/*",
    "packages/connector-worker/**/*",
    "packages/connectors/**/*",
    "packages/embeddings/**/*",
    "packages/owletto/**/*"
  ]
}
