{
  "name": "@lobu/views",
  "version": "20.3.1",
  "description": "Authoring runtime for Lobu views — React modules rendered in the sandboxed MCP Apps frame",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
