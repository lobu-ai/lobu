{
  "name": "@lobu/connector-sdk",
  "version": "19.2.0",
  "description": "Lobu memory SDK — build pluggable connectors for Lobu memory",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./define-connector": {
      "import": {
        "types": "./dist/define-connector.d.ts",
        "default": "./dist/define-connector.js"
      }
    },
    "./nix-package": {
      "import": {
        "types": "./dist/nix-package.d.ts",
        "default": "./dist/nix-package.js"
      },
      "require": {
        "types": "./dist/nix-package.d.ts",
        "default": "./dist/nix-package.js"
      }
    },
    "./identity-namespaces": {
      "types": "./dist/identity-namespaces.d.ts",
      "import": "./dist/identity-namespaces.js"
    },
    "./identity-normalize": {
      "types": "./dist/identity-normalize.d.ts",
      "import": "./dist/identity-normalize.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./ip-reachability": {
      "types": "./dist/ip-reachability.d.ts",
      "import": "./dist/ip-reachability.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "import": "./dist/net.js"
    },
    "./egress-policy": {
      "types": "./dist/egress-policy.d.ts",
      "import": "./dist/egress-policy.js"
    },
    "./browser/cdp": {
      "types": "./dist/browser/cdp.d.ts",
      "import": "./dist/browser/cdp.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./device-manifest-hash": {
      "types": "./dist/device-manifest-hash.d.ts",
      "import": "./dist/device-manifest-hash.js"
    }
  },
  "files": [
    "dist",
    "!**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lobu/core": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "isomorphic-git": "^1.34.0",
    "ky": "^1.14.0",
    "tar": "^7.4.3"
  },
  "peerDependencies": {
    "playwright": "npm:patchright@^1.57.0",
    "playwright-vanilla": "npm:playwright@^1.60.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "playwright-vanilla": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tar": "^6.1.13",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lobu-ai/lobu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobu-ai/lobu.git",
    "directory": "packages/connector-sdk"
  }
}
