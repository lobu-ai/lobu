// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`source-read scrub SQL > renders guarded assignments with guard=false 1`] = `
[
  "action_output = CASE",
  "    WHEN false AND (action_key = __lobu_feed_read OR run_metadata->>source_feed_read = 'true') THEN NULL",
  "    ELSE action_output END,",
  "    action_input = CASE WHEN false AND run_metadata->>source_feed_read = 'true' THEN '{"scrubbed":true}'::jsonb",
  "      ",
  "    WHEN false AND action_key = __lobu_feed_read THEN jsonb_build_object('scrubbed', true, 'feed_key', action_input->>'feed_key')",
  "    ELSE action_input END",
]
`;

exports[`source-read scrub SQL > renders guarded assignments with guard=true 1`] = `
[
  "action_output = CASE",
  "    WHEN true AND (action_key = __lobu_feed_read OR run_metadata->>source_feed_read = 'true') THEN NULL",
  "    ELSE action_output END,",
  "    action_input = CASE WHEN true AND run_metadata->>source_feed_read = 'true' THEN '{"scrubbed":true}'::jsonb",
  "      ",
  "    WHEN true AND action_key = __lobu_feed_read THEN jsonb_build_object('scrubbed', true, 'feed_key', action_input->>'feed_key')",
  "    ELSE action_input END",
]
`;

exports[`source-read scrub SQL > renders raw reaper assignments with the $5 binding 1`] = `
[
  "action_output = NULL,",
  "    action_input = CASE WHEN run_metadata->>$5 = 'true' THEN '{"scrubbed":true}'::jsonb",
  "      ELSE jsonb_build_object('scrubbed', true, 'feed_key', action_input->>'feed_key') END",
]
`;

exports[`source-read scrub SQL > renders source-read-only assignments with the supplied receipt 1`] = `
[
  "action_output = NULL,",
  "    action_input = CASE WHEN run_metadata->>source_feed_read = 'true' THEN '{"scrubbed":true}'::jsonb",
  "      ELSE {"scrubbed":true,"feed_key":"requested-feed"} END",
]
`;

exports[`source-read scrub SQL > renders the standard three-arm assignments 1`] = `
[
  "action_output = CASE",
  "    WHEN (action_key = __lobu_feed_read OR run_metadata->>source_feed_read = 'true') THEN NULL",
  "    ELSE action_output END,",
  "    action_input = CASE WHEN run_metadata->>source_feed_read = 'true' THEN '{"scrubbed":true}'::jsonb",
  "      ",
  "    WHEN action_key = __lobu_feed_read THEN jsonb_build_object('scrubbed', true, 'feed_key', action_input->>'feed_key')",
  "    ELSE action_input END",
]
`;
