{
  "name": "@lobu/plugin-media",
  "version": "0.0.0",
  "private": true,
  "description": "Lobu file, image, and audio tools plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "bun": "./src/portable.ts",
      "import": "./dist/portable.js",
      "require": "./dist/portable.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lobu/plugin-api": "workspace:*",
    "@lobu/plugin-toolkit": "workspace:*",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "^0.34.33"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22 <25 || >=26"
  },
  "license": "Apache-2.0"
}
