{
  "name": "@lobu/worker",
  "version": "19.2.0",
  "description": "Lobu worker runtime for embedded subprocess execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lobu-worker": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/build-worker-bundle.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "lobu",
    "worker",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobu-ai/lobu.git",
    "directory": "packages/agent-worker"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25 || >=26"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@lobu/core": "workspace:*",
    "@lobu/plugin-api": "workspace:*",
    "@lobu/plugin-conversations": "workspace:*",
    "@lobu/plugin-host": "workspace:*",
    "@lobu/plugin-mcp": "workspace:*",
    "@lobu/plugin-media": "workspace:*",
    "@lobu/plugin-memory": "workspace:*",
    "@lobu/plugin-toolkit": "workspace:*",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^10.6.0",
    "@sinclair/typebox": "^0.34.33",
    "form-data": "^4.0.4",
    "hono": "^4.11.7",
    "just-bash": "^2.12.8",
    "undici": "^7.29.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
