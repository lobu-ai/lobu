{
  "name": "@lobu/cli",
  "version": "20.0.0",
  "description": "CLI for deploying and managing AI agents on Lobu",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "bun": "./src/config/index.ts",
      "import": "./dist/config/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lobu": "bin/lobu.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/build.cjs",
    "dev": "tsc --watch"
  },
  "keywords": [
    "lobu",
    "ai",
    "agent",
    "deployment",
    "cli"
  ],
  "author": "Burak Emre",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobu-ai/lobu.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@inquirer/prompts": "^7.10.1",
    "@lobu/connector-sdk": "workspace:*",
    "@lobu/core": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "chalk": "^5.3.0",
    "commander": "^14.0.1",
    "esbuild": "^0.28.1",
    "jiti": "^2.4.2",
    "marked": "^17.0.4",
    "marked-terminal": "^7.3.0",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "postgres": "^3.4.7",
    "tar": "^7.4.3",
    "yaml": "^2.7.1",
    "proper-lockfile": "4.1.2",
    "ajv": "^8.17.1",
    "cron-parser": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.8.3",
    "@lobu/connector-worker": "workspace:*",
    "@types/proper-lockfile": "4.1.4"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "src/config",
    "!src/config/**/__tests__/**",
    "!src/config/**/*.test.ts",
    "!src/config/**/*.spec.ts",
    "!**/*.map",
    "!dist/commands/daemon.js",
    "!dist/commands/automation.js",
    "!dist/commands/connector.js"
  ],
  "engines": {
    "node": ">=22 <25 || >=26"
  }
}
