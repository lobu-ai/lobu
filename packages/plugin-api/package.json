{
  "name": "@lobu/plugin-api",
  "version": "19.2.0",
  "description": "Native first-party plugin contract for Lobu runtimes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22 <25 || >=26"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
