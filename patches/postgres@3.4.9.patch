diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..6f9ea35bc6413ac0e8528970859dc0ae8e77714e 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -159,6 +159,14 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    if (!socket) {
+      // A stale reservation can execute after closed() clears the socket.
+      // Do not signal backpressure: this connection cannot emit a drain event
+      // to resume queries queued behind the rejected write.
+      queryError(q, Errors.connection('CONNECTION_CLOSED', options))
+      return true
+    }
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
@@ -254,6 +262,16 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
+    if (!socket) {
+      // Cursor and COPY writes can still arrive after closed() clears the
+      // socket. A throw from this timer would be an uncaughtException, so
+      // reject the pending queries instead. Report no backpressure: a closed
+      // socket never emits the drain event that would resume them.
+      nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      error(Errors.connection('CONNECTION_CLOSED', options))
+      return true
+    }
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
@@ -566,9 +584,12 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         return fetchArrayTypes()
       }
 
-      initial && !initial.reserve && execute(initial)
-      options.shared.retries = retries = 0
+      const pending = initial
       initial = null
+      options.shared.retries = retries = 0
+      // A cold reserve is queued by the pool. Without a type-fetch query,
+      // no second ReadyForQuery arrives to hand this connection to it.
+      pending && !pending.reserve ? execute(pending) : onopen(connection)
       return
     }
 
